{
  "name": "career-ops",
  "version": "1.28.0",
  "description": "AI-powered job search pipeline — works with any AI coding CLI (Claude Code, Codex, OpenCode, Antigravity, Grok, Qwen, Kimi, Copilot)",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "career-ops": "bin/career-ops"
  },
  "scripts": {
    "doctor": "node doctor.mjs",
    "or": "node src/scripts/openrouter-runner.mjs",
    "or:scan": "node src/scripts/openrouter-runner.mjs scan",
    "or:pipeline": "node src/scripts/openrouter-runner.mjs pipeline",
    "or:eval": "node src/scripts/openrouter-runner.mjs evaluate",
    "or:apply": "node src/scripts/openrouter-runner.mjs apply",
    "verify": "node src/scripts/verify-pipeline.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "normalize": "node src/scripts/normalize-statuses.mjs",
    "dedup": "node src/scripts/dedup-tracker.mjs",
    "merge": "node merge-tracker.mjs",
    "reconcile": "node src/scripts/reconcile-pipeline.mjs",
    "pdf": "node generate-pdf.mjs",
    "jd:similarity": "node src/scripts/jd-similarity.mjs",
    "img-to-pdf": "node src/scripts/img-to-pdf.mjs",
    "cover-letter": "node src/scripts/generate-cover-letter.mjs --payload",
    "cv:verify-facts": "node src/scripts/verify-cv-facts.mjs",
    "test:cv-visual": "playwright test --config=src/scripts/playwright.cv.config.mjs",
    "test:cv-visual:update": "playwright test --config=src/scripts/playwright.cv.config.mjs --update-snapshots",
    "sync-check": "node src/scripts/cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update:test": "node tests/updater-migration.test.mjs",
    "update": "node update-system.mjs apply",
    "rollback": "node update-system.mjs rollback",
    "liveness": "node src/scripts/check-liveness.mjs",
    "extract": "node src/scripts/browser-extract.mjs",
    "scan:hn": "node src/scripts/scan-hn.mjs",
    "scan": "node scan.mjs",
    "scan:full": "node scan-ats-full.mjs",
    "scan:seeds": "node scan-ats-full.mjs --seeds yc,a16z",
    "scan:yc": "node scan-ats-full.mjs --seeds yc",
    "scan:interamt": "node src/scripts/scan-interamt.mjs",
    "company:funded": "node src/scripts/company-funded.mjs",
    "validate:portals": "node src/scripts/validate-portals.mjs",
    "verify:portals": "node verify-portals.mjs",
    "tracker": "node tracker.mjs",
    "find": "node src/scripts/find.mjs",
    "patterns": "node src/scripts/analyze-patterns.mjs",
    "upskill": "node src/scripts/upskill.mjs",
    "add": "node src/scripts/add-entry.mjs",
    "reposts": "node src/scripts/detect-reposts.mjs",
    "digest": "node src/scripts/weekly-digest.mjs",
    "freshness": "node src/scripts/check-table-freshness.mjs",
    "rejection-latency": "node src/scripts/rejection-latency.mjs",
    "invite-match": "node src/scripts/invite-match.mjs",
    "paste-reply": "node src/scripts/paste-reply.mjs",
    "gemini:eval": "node src/scripts/gemini-eval.mjs",
    "ollama:eval": "node src/scripts/ollama-eval.mjs",
    "openai:eval": "node src/scripts/openai-eval.mjs",
    "openai:tailor": "node src/scripts/openai-tailor.mjs",
    "eval:golden": "node src/scripts/eval-golden.mjs",
    "star": "node src/lib/match-star.mjs",
    "archive": "node src/scripts/archive-posting.mjs",
    "prepare:application": "node src/scripts/prepare-application.mjs",
    "application:init": "node src/scripts/application-artifacts.mjs --init",
    "build:dashboard": "node src/scripts/build-dashboard.mjs",
    "serve:dashboard": "cd dashboard && go run . --path ..",
    "postinstall": "npx playwright install chromium --with-deps || npx playwright install chromium --with-deps",
    "manifesto": "node src/scripts/manifesto.mjs"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "opencode",
    "career",
    "career-ops",
    "careerops",
    "automation",
    "codex",
    "antigravity",
    "qwen",
    "kimi",
    "copilot",
    "grok",
    "ai-agent-skill"
  ],
  "author": "Santiago Fernández de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://santifer.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/santifer/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.0.0",
    "js-yaml": "^5.3.0",
    "playwright": "1.62.1"
  }
}
